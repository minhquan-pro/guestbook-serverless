# Copy file này thành .env.local rồi điền giá trị thật:
#   cp .env.local.example .env.local
#
# Base URL của API Gateway (KHÔNG có dấu / ở cuối).
# Lấy từ output của backend stack sau khi sam deploy:
#
#   aws cloudformation describe-stacks \
#     --stack-name guestbook-serverless \
#     --region us-east-1 \
#     --query 'Stacks[0].Outputs[?OutputKey==`ApiEndpoint`].OutputValue' \
#     --output text
#
# Tiền tố NEXT_PUBLIC_ là bắt buộc để biến này dùng được ở client component.
# Lưu ý: giá trị sẽ bị nhúng vào bundle JS công khai, đừng đặt secret ở đây.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
